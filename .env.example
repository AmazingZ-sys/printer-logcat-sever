# Copy to .env and replace both public placeholders before starting.
# Tokens must each contain at least 16 characters and must be different.
INGEST_TOKEN=replace-with-your-ingest-token-at-least-16-characters
VIEW_TOKEN=replace-with-your-view-token-at-least-16-characters

# Local Node development settings. Server Compose uses its inline environment.
HOST=0.0.0.0
PORT=3000
DB_PATH=./data/logs.db
RETENTION_DAYS=7
MAX_LOGS=100000

# Comma-separated browser origins, or * for every origin.
CORS_ORIGINS=*
